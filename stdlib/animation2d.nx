// Time-based sprite-sheet frame helpers. Rendering is handled by std.sprite2d.
import std.math

fn animation2d_frame_at(elapsed_seconds: f64, frame_count: i64, frames_per_second: f64,
looped: bool) -> i64 {
    if frame_count <= 0 || frames_per_second <= 0.0 { return 0 }
    let mut elapsed = elapsed_seconds
    if elapsed < 0.0 { elapsed = 0.0 }
    let frame = math_floor(elapsed * frames_per_second)
    if looped { return frame % frame_count }
    if frame >= frame_count { return frame_count - 1 }
    return frame
}

fn animation2d_next_frame(current: i64, frame_count: i64, looped: bool) -> i64 {
    if frame_count <= 0 { return 0 }
    if current < 0 { return 0 }
    if current + 1 < frame_count { return current + 1 }
    if looped { return 0 }
    return frame_count - 1
}

// Smooth interpolation curves. All amount inputs are clamped to [0, 1].
fn animation2d_ease_in(amount: f64) -> f64 {
    let t = math_clamp(amount, 0.0, 1.0)
    return t * t
}

fn animation2d_ease_out(amount: f64) -> f64 {
    let t = math_clamp(amount, 0.0, 1.0)
    return 1.0 -(1.0 - t) *(1.0 - t)
}

fn animation2d_ease_in_out(amount: f64) -> f64 {
    let t = math_clamp(amount, 0.0, 1.0)
    if t < 0.5 { return 2.0 * t * t }
    let u = 1.0 - t
    return 1.0 - 2.0 * u * u
}

fn animation2d_smoothstep(amount: f64) -> f64 {
    let t = math_clamp(amount, 0.0, 1.0)
    return t * t *(3.0 - 2.0 * t)
}

// Repeating triangle wave from 0 to 1 to 0; non-positive duration returns 0.
fn animation2d_ping_pong(elapsed_seconds: f64, duration: f64) -> f64 {
    if duration <= 0.0 { return 0.0 }
    let mut t = elapsed_seconds
    if t < 0.0 { t = 0.0 }
    let whole = math_floor(t / duration)
    let phase = whole % 2
    let local =(t / duration) - to_f64(whole)
    if phase == 0 { return local }
    return 1.0 - local
}


fn animation2d_duration(frame_count: i64, frames_per_second: f64) -> f64 {
    if frame_count <= 0 || frames_per_second <= 0.0 { return 0.0 }
    return to_f64(frame_count) / frames_per_second
}

// Normalized progress: looped animations wrap to [0, 1); one-shots clamp to [0, 1].
fn animation2d_progress(elapsed_seconds: f64, duration: f64, looped: bool) -> f64 {
    if duration <= 0.0 { return 1.0 }
    let mut elapsed = elapsed_seconds
    if elapsed < 0.0 { elapsed = 0.0 }
    let amount = elapsed / duration
    if ! looped { return math_clamp(amount, 0.0, 1.0) }
    return amount - to_f64(math_floor(amount))
}
