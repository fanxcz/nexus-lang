// Concrete Result helper built on payload enums.
// NEXUS does not yet have generics, so this operates on i64 values and string errors.

enum Result { Ok(i64), Err(string) }

fn result_ok(value: i64) -> Result { return Result::Ok(value) }
fn result_err(message: string) -> Result { return Result::Err(message) }
fn result_is_ok(value: Result) -> bool {
    match value {
        Result::Ok(_) => { return true }
        Result::Err(_) => { return false }
    }
    return false
}
fn result_unwrap(value: Result) -> i64 {
    match value {
        Result::Ok(v) => { return v }
        Result::Err(_) => { return 0 }
    }
    return 0
}

// Safe extraction: returns false for Err and leaves the output unchanged.
fn result_try_unwrap(value: Result, out: *i64) -> bool {
    match value {
        Result::Ok(item) => { *out = item; return true }
        Result::Err(_) => { return false }
    }
    return false
}

fn result_unwrap_or(value: Result, fallback: i64) -> i64 {
    match value {
        Result::Ok(item) => { return item }
        Result::Err(_) => { return fallback }
    }
    return fallback
}

// Retrieve the error text explicitly. Use result_try_error when an empty error
// message must be distinguished from a successful result.
fn result_try_error(value: Result, out: *string) -> bool {
    match value {
        Result::Ok(_) => { return false }
        Result::Err(message) => { *out = message; return true }
    }
    return false
}
