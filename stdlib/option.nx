// Concrete Option and Result helpers built on payload enums.
// NEXUS does not yet have generics, so these operate on i64 payloads.
// Other enums can use one payload of i64, f64, bool, string, or pointer type.

enum Option { Some(i64), None }

fn option_some(value: i64) -> Option { return Option::Some(value) }
fn option_none() -> Option { return Option::None }
fn option_is_some(value: Option) -> bool {
    match value {
        Option::Some(_) => { return true }
        Option::None => { return false }
    }
    return false
}
fn option_unwrap(value: Option) -> i64 {
    match value {
        Option::Some(v) => { return v }
        Option::None => { return 0 }
    }
    return 0
}

// Safe extraction: returns false for None and leaves the output unchanged.
fn option_try_unwrap(value: Option, out: *i64) -> bool {
    match value {
        Option::Some(item) => { *out = item; return true }
        Option::None => { return false }
    }
    return false
}

// Explicit fallback is safer than silently treating None as numeric zero.
fn option_unwrap_or(value: Option, fallback: i64) -> i64 {
    match value {
        Option::Some(item) => { return item }
        Option::None => { return fallback }
    }
    return fallback
}
