// End-to-end test: NEXUS-written compiler compiles and runs a NEXUS program.
// Pipeline: lexer -> parser -> codegen (.ll) -> clang++ -> execute -> compare.
// Requires NEXUS_CXX (clang-compatible) in the environment.
import "codegen_lib.nx"

fn line_is(out: string, index: i64, want: string) -> bool {
    return string.trim(string.split_at(out, "\n", index)) == want
}

fn main() {
    // Keep self-hosted compile-and-run checks portable across Windows, Linux and macOS.
    let mut platformLinkFlags = ""
    let mut executablePrefix = "./"
    if env("OS") == "Windows_NT" {
        platformLinkFlags = " -lkernel32 -luser32 -lgdi32 -lshell32 -lole32"
        executablePrefix = ""
    }

    let src = file_read("selfhost/tests/hello_subset.nx")
    if string.len(src) == 0 {
        print("FAIL cannot read selfhost/tests/hello_subset.nx")
        exit(1)
    }
    let ll = codegen(src)
    if string.slice(ll, 0, 5) == "error" {
        print("FAIL codegen: " + ll)
        exit(1)
    }
    file_write("selfhost-test.ll", ll)

    let mut cxx = env("NEXUS_CXX")
    if cxx == "" {
        cxx = "clang++"
    }
    let rc = system("\"" + cxx + "\" -std=c++20 -D_CRT_SECURE_NO_WARNINGS selfhost-test.ll src/runtime/runtime.cpp -o selfhost-test.exe" + platformLinkFlags)
    if rc != 0 {
        print("FAIL clang++ rc=" + rc)
        exit(1)
    }
    let run_rc = system(executablePrefix + "selfhost-test.exe > selfhost-out.txt 2>&1")
    if run_rc != 0 {
        print("FAIL run rc=" + str_i64(run_rc) + " output: " + file_read("selfhost-out.txt"))
        exit(1)
    }
    let out = string.trim(file_read("selfhost-out.txt"))
    if string.split_count(out, "\n") < 3 {
        print("FAIL unexpected output: [" + out + "]")
        exit(1)
    }
    if !line_is(out, 0, "42") {
        print("FAIL line0: " + string.trim(string.split_at(out, "\n", 0)))
        exit(1)
    }
    if !line_is(out, 1, "10") {
        print("FAIL line1: " + string.trim(string.split_at(out, "\n", 1)))
        exit(1)
    }
    if !line_is(out, 2, "1") {
        print("FAIL line2: " + string.trim(string.split_at(out, "\n", 2)))
        exit(1)
    }
    // Second case: functions and calls.
    let src2 = file_read("selfhost/tests/fn_subset.nx")
    if string.len(src2) == 0 {
        print("FAIL cannot read selfhost/tests/fn_subset.nx")
        exit(1)
    }
    let ll2 = codegen(src2)
    if string.slice(ll2, 0, 5) == "error" {
        print("FAIL codegen fn: " + ll2)
        exit(1)
    }
    file_write("selfhost-fn.ll", ll2)

    let rc2 = system("\"" + cxx + "\" -std=c++20 -D_CRT_SECURE_NO_WARNINGS selfhost-fn.ll src/runtime/runtime.cpp -o selfhost-fn.exe" + platformLinkFlags)
    if rc2 != 0 {
        print("FAIL clang++ fn rc=" + rc2)
        exit(1)
    }
    let run_rc2 = system(executablePrefix + "selfhost-fn.exe > selfhost-fn-out.txt 2>&1")
    if run_rc2 != 0 {
        print("FAIL run fn rc=" + str_i64(run_rc2) + " output: " + file_read("selfhost-fn-out.txt"))
        exit(1)
    }
    let out2 = string.trim(file_read("selfhost-fn-out.txt"))
    if string.split_count(out2, "\n") < 2 {
        print("FAIL unexpected fn output: [" + out2 + "]")
        exit(1)
    }
    if !line_is(out2, 0, "42") {
        print("FAIL fn line0: " + string.trim(string.split_at(out2, "\n", 0)))
        exit(1)
    }
    if !line_is(out2, 1, "6") {
        print("FAIL fn line1: " + string.trim(string.split_at(out2, "\n", 1)))
        exit(1)
    }
    // Third case: string literals in print.
    let src3 = file_read("selfhost/tests/str_subset.nx")
    if string.len(src3) == 0 {
        print("FAIL cannot read selfhost/tests/str_subset.nx")
        exit(1)
    }
    let ll3 = codegen(src3)
    if string.slice(ll3, 0, 5) == "error" {
        print("FAIL codegen str: " + ll3)
        exit(1)
    }
    file_write("selfhost-str.ll", ll3)
    let rc3 = system("\"" + cxx + "\" -std=c++20 -D_CRT_SECURE_NO_WARNINGS selfhost-str.ll src/runtime/runtime.cpp -o selfhost-str.exe" + platformLinkFlags)
    if rc3 != 0 {
        print("FAIL clang++ str rc=" + rc3)
        exit(1)
    }
    let run_rc3 = system(executablePrefix + "selfhost-str.exe > selfhost-str-out.txt 2>&1")
    if run_rc3 != 0 {
        print("FAIL run str rc=" + str_i64(run_rc3) + " output: " + file_read("selfhost-str-out.txt"))
        exit(1)
    }
    let out3 = string.trim(file_read("selfhost-str-out.txt"))
    if !line_is(out3, 0, "hello") {
        print("FAIL str line0: " + string.trim(string.split_at(out3, "\n", 0)))
        exit(1)
    }
    if !line_is(out3, 1, "a b") {
        print("FAIL str line1: " + string.trim(string.split_at(out3, "\n", 1)))
        exit(1)
    }
    if !line_is(out3, 2, "7") {
        print("FAIL str line2: " + string.trim(string.split_at(out3, "\n", 2)))
        exit(1)
    }

    // Fourth case: f64 arithmetic and print.
    let src4 = file_read("selfhost/tests/float_subset.nx")
    if string.len(src4) == 0 {
        print("FAIL cannot read selfhost/tests/float_subset.nx")
        exit(1)
    }
    let ll4 = codegen(src4)
    if string.slice(ll4, 0, 5) == "error" {
        print("FAIL codegen float: " + ll4)
        exit(1)
    }
    file_write("selfhost-float.ll", ll4)
    let rc4 = system("\"" + cxx + "\" -std=c++20 -D_CRT_SECURE_NO_WARNINGS selfhost-float.ll src/runtime/runtime.cpp -o selfhost-float.exe" + platformLinkFlags)
    if rc4 != 0 {
        print("FAIL clang++ float rc=" + rc4)
        exit(1)
    }
    let run_rc4 = system(executablePrefix + "selfhost-float.exe > selfhost-float-out.txt 2>&1")
    if run_rc4 != 0 {
        print("FAIL run float rc=" + str_i64(run_rc4) + " output: " + file_read("selfhost-float-out.txt"))
        exit(1)
    }
    let out4 = string.trim(file_read("selfhost-float-out.txt"))
    if !line_is(out4, 0, "3.5") {
        print("FAIL float line0: " + string.trim(string.split_at(out4, "\n", 0)))
        exit(1)
    }
    if !line_is(out4, 1, "3") {
        print("FAIL float line1: " + string.trim(string.split_at(out4, "\n", 1)))
        exit(1)
    }

    // Fifth case: bool and logical not.
    let src5 = file_read("selfhost/tests/bool_subset.nx")
    if string.len(src5) == 0 {
        print("FAIL cannot read selfhost/tests/bool_subset.nx")
        exit(1)
    }
    let ll5 = codegen(src5)
    if string.slice(ll5, 0, 5) == "error" {
        print("FAIL codegen bool: " + ll5)
        exit(1)
    }
    file_write("selfhost-bool.ll", ll5)
    let rc5 = system("\"" + cxx + "\" -std=c++20 -D_CRT_SECURE_NO_WARNINGS selfhost-bool.ll src/runtime/runtime.cpp -o selfhost-bool.exe" + platformLinkFlags)
    if rc5 != 0 {
        print("FAIL clang++ bool rc=" + rc5)
        exit(1)
    }
    let run_rc5 = system(executablePrefix + "selfhost-bool.exe > selfhost-bool-out.txt 2>&1")
    if run_rc5 != 0 {
        print("FAIL run bool rc=" + str_i64(run_rc5) + " output: " + file_read("selfhost-bool-out.txt"))
        exit(1)
    }
    let out5 = string.trim(file_read("selfhost-bool-out.txt"))
    if !line_is(out5, 0, "true") {
        print("FAIL bool line0: " + string.trim(string.split_at(out5, "\n", 0)))
        exit(1)
    }
    if !line_is(out5, 1, "false") {
        print("FAIL bool line1: " + string.trim(string.split_at(out5, "\n", 1)))
        exit(1)
    }
    if !line_is(out5, 2, "1") {
        print("FAIL bool line2: " + string.trim(string.split_at(out5, "\n", 2)))
        exit(1)
    }

    // Sixth case: break and continue.
    let src6 = file_read("selfhost/tests/loop_subset.nx")
    if string.len(src6) == 0 {
        print("FAIL cannot read selfhost/tests/loop_subset.nx")
        exit(1)
    }
    let ll6 = codegen(src6)
    if string.slice(ll6, 0, 5) == "error" {
        print("FAIL codegen loop: " + ll6)
        exit(1)
    }
    file_write("selfhost-loop.ll", ll6)
    let rc6 = system("\"" + cxx + "\" -std=c++20 -D_CRT_SECURE_NO_WARNINGS selfhost-loop.ll src/runtime/runtime.cpp -o selfhost-loop.exe" + platformLinkFlags)
    if rc6 != 0 {
        print("FAIL clang++ loop rc=" + rc6)
        exit(1)
    }
    let run_rc6 = system(executablePrefix + "selfhost-loop.exe > selfhost-loop-out.txt 2>&1")
    if run_rc6 != 0 {
        print("FAIL run loop rc=" + str_i64(run_rc6) + " output: " + file_read("selfhost-loop-out.txt"))
        exit(1)
    }
    let out6 = string.trim(file_read("selfhost-loop-out.txt"))
    if !line_is(out6, 0, "1") {
        print("FAIL loop line0: " + string.trim(string.split_at(out6, "\n", 0)))
        exit(1)
    }
    if !line_is(out6, 1, "3") {
        print("FAIL loop line1: " + string.trim(string.split_at(out6, "\n", 1)))
        exit(1)
    }
    if !line_is(out6, 2, "99") {
        print("FAIL loop line2: " + string.trim(string.split_at(out6, "\n", 2)))
        exit(1)
    }

    // Seventh case: for loops.
    let src7 = file_read("selfhost/tests/for_subset.nx")
    if string.len(src7) == 0 {
        print("FAIL cannot read selfhost/tests/for_subset.nx")
        exit(1)
    }
    let ll7 = codegen(src7)
    if string.slice(ll7, 0, 5) == "error" {
        print("FAIL codegen for: " + ll7)
        exit(1)
    }
    file_write("selfhost-for.ll", ll7)
    let rc7 = system("\"" + cxx + "\" -std=c++20 -D_CRT_SECURE_NO_WARNINGS selfhost-for.ll src/runtime/runtime.cpp -o selfhost-for.exe" + platformLinkFlags)
    if rc7 != 0 {
        print("FAIL clang++ for rc=" + rc7)
        exit(1)
    }
    let run_rc7 = system(executablePrefix + "selfhost-for.exe > selfhost-for-out.txt 2>&1")
    if run_rc7 != 0 {
        print("FAIL run for rc=" + str_i64(run_rc7) + " output: " + file_read("selfhost-for-out.txt"))
        exit(1)
    }
    let out7 = string.trim(file_read("selfhost-for-out.txt"))
    if !line_is(out7, 0, "0") {
        print("FAIL for line0: " + string.trim(string.split_at(out7, "\n", 0)))
        exit(1)
    }
    if !line_is(out7, 4, "4") {
        print("FAIL for line4: " + string.trim(string.split_at(out7, "\n", 4)))
        exit(1)
    }
    if !line_is(out7, 5, "99") {
        print("FAIL for line5: " + string.trim(string.split_at(out7, "\n", 5)))
        exit(1)
    }

    // Remove temporary test outputs from the source tree.
    if env("OS") == "Windows_NT" {
        system("del /Q selfhost-*.ll selfhost-*.exe selfhost-*-out.txt >NUL 2>NUL")
    } else {
        system("rm -f selfhost-*.ll selfhost-*.exe selfhost-*-out.txt")
    }
    print("all codegen tests passed")
}
