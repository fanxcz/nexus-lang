// Self-hosting step 3: type checking for the parser's subset, in NEXUS.
// typecheck(src) -> "ok" or "error MESSAGE".
//
// Checks: variables must be declared before use, `+ - * / %` operands must be
// numeric (or strings for `+`), `!` needs bool, `-` needs a number,
// comparisons and `&&`/`||` produce bool, `if`/`while` conditions must be
// bool, assignments must not change a variable's type.
import "parser_lib.nx"

// ---- S-expression reader (whitespace- and newline-agnostic) ----

fn skip_ws(text: string, p: i64) {
    let n = string.len(text)
    let mut i = ilist_get(p, 0)
    while i < n {
        let b = string.byte_at(text, i)
        if b == 32 || b == 10 || b == 9 || b == 13 {
            i = i + 1
        } else {
            break
        }
    }
    ilist_set(p, 0, i)
}

// Reads one complete node starting at p; returns "" when nothing is left.
fn read_node(text: string, p: i64) -> string {
    skip_ws(text, p)
    let n = string.len(text)
    let start = ilist_get(p, 0)
    if start >= n {
        return ""
    }
    if string.byte_at(text, start) == 40 {
        let mut depth = 0
        let mut i = start
        while i < n {
            let b = string.byte_at(text, i)
            if b == 40 {
                depth = depth + 1
            } else if b == 41 {
                depth = depth - 1
                if depth == 0 {
                    ilist_set(p, 0, i + 1)
                    return string.slice(text, start, i + 1)
                }
            }
            i = i + 1
        }
        return ""
    }
    // bare atom
    let mut j = start
    while j < n {
        let b = string.byte_at(text, j)
        if b == 32 || b == 10 || b == 9 || b == 13 || b == 40 || b == 41 {
            break
        }
        j = j + 1
    }
    ilist_set(p, 0, j)
    return string.slice(text, start, j)
}

// Body of "(...)" without the outer parens.
fn node_body(node: string) -> string {
    let n = string.len(node)
    if n >= 2 && string.byte_at(node, 0) == 40 && string.byte_at(node, n - 1) == 41 {
        return string.slice(node, 1, n - 1)
    }
    return node
}

fn head_of(node: string) -> string {
    let p = ilist_new()
    ilist_push(p, 0)
    return read_node(node_body(node), p)
}

// ---- variable environment: parallel slists ----

fn env_lookup(names: i64, types: i64, name: string) -> string {
    let k = slist_len(names)
    let mut i = k - 1
    while i >= 0 {
        if slist_get(names, i) == name {
            return slist_get(types, i)
        }
        i = i - 1
    }
    return ""
}

fn is_numeric(t: string) -> bool {
    return t == "i64" || t == "f64"
}

// ---- expression type inference; returns "i64"/"f64"/"string"/"bool"/"unknown"
//      or "error ..." ----

fn infer(node: string, names: i64, types: i64) -> string {
    let h = head_of(node)
    if h == "int" {
        return "i64"
    }
    if h == "float" {
        return "f64"
    }
    if h == "str" {
        return "string"
    }
    if h == "bool" {
        return "bool"
    }
    if h == "ident" {
        let p = ilist_new()
        ilist_push(p, 0)
        let body = node_body(node)
        skip_ws(body, p)
        read_node(body, p)  // skip the head atom
        let name = read_node(body, p)
        let t = env_lookup(names, types, name)
        if t == "" {
            return "error unknown variable: " + name
        }
        return t
    }
    if h == "call" {
        return "unknown"
    }
    if h == "neg" {
        let p = ilist_new()
        ilist_push(p, 0)
        let body = node_body(node)
        skip_ws(body, p)
        read_node(body, p)  // skip the head atom
        let inner = read_node(body, p)
        let t = infer(inner, names, types)
        if string.slice(t, 0, 5) == "error" {
            return t
        }
        if !is_numeric(t) {
            return "error unary - requires a number"
        }
        return t
    }
    if h == "not" {
        let p = ilist_new()
        ilist_push(p, 0)
        let body = node_body(node)
        skip_ws(body, p)
        read_node(body, p)  // skip the head atom
        let inner = read_node(body, p)
        let t = infer(inner, names, types)
        if string.slice(t, 0, 5) == "error" {
            return t
        }
        if t != "bool" {
            return "error ! requires bool"
        }
        return "bool"
    }
    if h == "+" || h == "-" || h == "*" || h == "/" || h == "%" {
        let p = ilist_new()
        ilist_push(p, 0)
        let body = node_body(node)
        skip_ws(body, p)
        read_node(body, p)  // skip the head atom
        let lhs = read_node(body, p)
        let rhs = read_node(body, p)
        let lt = infer(lhs, names, types)
        if string.slice(lt, 0, 5) == "error" {
            return lt
        }
        let rt = infer(rhs, names, types)
        if string.slice(rt, 0, 5) == "error" {
            return rt
        }
        if lt == "unknown" || rt == "unknown" {
            return "unknown"
        }
        if h == "+" && (lt == "string" || rt == "string") {
            return "string"
        }
        if !is_numeric(lt) || !is_numeric(rt) {
            return "error operator " + h + " requires numbers, got " + lt + " and " + rt
        }
        if lt == "f64" || rt == "f64" {
            return "f64"
        }
        return "i64"
    }
    if h == "==" || h == "!=" || h == "<" || h == "<=" || h == ">" || h == ">=" {
        let p = ilist_new()
        ilist_push(p, 0)
        let body = node_body(node)
        skip_ws(body, p)
        read_node(body, p)  // skip the head atom
        let lhs = read_node(body, p)
        let rhs = read_node(body, p)
        let lt = infer(lhs, names, types)
        if string.slice(lt, 0, 5) == "error" {
            return lt
        }
        let rt = infer(rhs, names, types)
        if string.slice(rt, 0, 5) == "error" {
            return rt
        }
        if lt == "unknown" || rt == "unknown" {
            return "unknown"
        }
        if lt != rt {
            return "error cannot compare " + lt + " with " + rt
        }
        return "bool"
    }
    if h == "&&" || h == "||" {
        let p = ilist_new()
        ilist_push(p, 0)
        let body = node_body(node)
        skip_ws(body, p)
        read_node(body, p)  // skip the head atom
        let lhs = read_node(body, p)
        let rhs = read_node(body, p)
        let lt = infer(lhs, names, types)
        if string.slice(lt, 0, 5) == "error" {
            return lt
        }
        let rt = infer(rhs, names, types)
        if string.slice(rt, 0, 5) == "error" {
            return rt
        }
        if lt != "bool" || rt != "bool" {
            return "error " + h + " requires bool operands"
        }
        return "bool"
    }
    return "unknown"
}

// ---- function checking ----

fn check_fn(node: string, names: i64, types: i64) -> string {
    let p = ilist_new()
    ilist_push(p, 0)
    let body = node_body(node)
    skip_ws(body, p)
    read_node(body, p)  // fn
    read_node(body, p)  // name
    let params_node = read_node(body, p)
    read_node(body, p)  // ret
    let fn_body = read_node(body, p)

    let lnames = slist_new()
    let ltypes = slist_new()
    let pp = ilist_new()
    ilist_push(pp, 0)
    let params_body = node_body(params_node)
    skip_ws(params_body, pp)
    read_node(params_body, pp)  // params
    let mut pr = read_node(params_body, pp)
    while pr != "" {
        let rpp = ilist_new()
        ilist_push(rpp, 0)
        let pb = node_body(pr)
        skip_ws(pb, rpp)
        read_node(pb, rpp)  // param
        let pname = read_node(pb, rpp)
        let ptype = read_node(pb, rpp)
        slist_push(lnames, pname)
        slist_push(ltypes, ptype)
        pr = read_node(params_body, pp)
    }
    return check_block(fn_body, lnames, ltypes)
}

// ---- statement checking ----

fn check_stmt(node: string, names: i64, types: i64) -> string {
    let h = head_of(node)
    if h == "fn" {
        return check_fn(node, names, types)
    }
    if h == "let" {
        let p = ilist_new()
        ilist_push(p, 0)
        let body = node_body(node)
        skip_ws(body, p)
        read_node(body, p)  // skip the head atom
        let name = read_node(body, p)
        let init = read_node(body, p)
        let t = infer(init, names, types)
        if string.slice(t, 0, 5) == "error" {
            return t
        }
        slist_push(names, name)
        slist_push(types, t)
        return "ok"
    }
    if h == "assign" {
        let p = ilist_new()
        ilist_push(p, 0)
        let body = node_body(node)
        skip_ws(body, p)
        read_node(body, p)  // skip the head atom
        let name = read_node(body, p)
        let value = read_node(body, p)
        let want = env_lookup(names, types, name)
        if want == "" {
            return "error unknown variable: " + name
        }
        let t = infer(value, names, types)
        if string.slice(t, 0, 5) == "error" {
            return t
        }
        if t != "unknown" && t != want {
            return "error cannot assign " + t + " to " + name + " of type " + want
        }
        return "ok"
    }
    if h == "print" || h == "expr" {
        let p = ilist_new()
        ilist_push(p, 0)
        let body = node_body(node)
        skip_ws(body, p)
        read_node(body, p)  // skip the head atom
        let value = read_node(body, p)
        let t = infer(value, names, types)
        if string.slice(t, 0, 5) == "error" {
            return t
        }
        return "ok"
    }
    if h == "if" || h == "while" {
        let p = ilist_new()
        ilist_push(p, 0)
        let body = node_body(node)
        skip_ws(body, p)
        read_node(body, p)  // skip the head atom
        let cond = read_node(body, p)
        let ct = infer(cond, names, types)
        if string.slice(ct, 0, 5) == "error" {
            return ct
        }
        if ct != "unknown" && ct != "bool" {
            return "error condition must be bool, got " + ct
        }
        // check nested statements in block children
        let mut r = read_node(body, p)
        while r != "" {
            if head_of(r) == "block" || head_of(r) == "if" || head_of(r) == "while" {
                let inner = check_block(r, names, types)
                if string.slice(inner, 0, 5) == "error" {
                    return inner
                }
            }
            r = read_node(body, p)
        }
        return "ok"
    }
    return "ok"
}

fn check_block(node: string, names: i64, types: i64) -> string {
    let p = ilist_new()
    ilist_push(p, 0)
    let body = node_body(node)
    let mut r = read_node(body, p)
    while r != "" {
        let res = check_stmt(r, names, types)
        if string.slice(res, 0, 5) == "error" {
            return res
        }
        r = read_node(body, p)
    }
    return "ok"
}

fn typecheck(src: string) -> string {
    let tree = parse(src)
    if string.slice(tree, 0, 5) == "error" {
        return tree
    }
    let names = slist_new()
    let types = slist_new()
    let p = ilist_new()
    ilist_push(p, 0)
    let mut node = read_node(tree, p)
    while node != "" {
        let res = check_stmt(node, names, types)
        if string.slice(res, 0, 5) == "error" {
            return res
        }
        node = read_node(tree, p)
    }
    return "ok"
}
