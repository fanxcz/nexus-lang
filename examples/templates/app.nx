fn main() {
    let ok = gfx_init(1000, 640, "NEXUS App")
    if !ok { print("Graphics backend unavailable: " + gfx_error()); return }
    let mut clicks: i64 = 0
    while !gfx_should_close() {
        gfx_poll()
        if gfx_key_down("ESC") { break }
        if gfx_mouse_down(1) { clicks = clicks + 1 }
        gfx_begin()
        gfx_clear(0.035, 0.045, 0.08, 1.0)
        gfx_rect(40.0, 40.0, 920.0, 110.0, 0.07, 0.12, 0.22, 1.0)
        gfx_text(70.0, 70.0, 3.0, "NEXUS APP", 0.55, 0.9, 1.0, 1.0)
        gfx_text(70.0, 120.0, 1.5, "Native window / mouse / keyboard / events", 0.8, 0.84, 0.95, 1.0)
        gfx_rect(80.0, 230.0, 320.0, 120.0, 0.12, 0.5, 0.9, 1.0)
        gfx_text(145.0, 270.0, 2.0, "CLICK ME", 1.0, 1.0, 1.0, 1.0)
        gfx_text(80.0, 410.0, 1.6, "CLICKS", 0.65, 0.75, 0.9, 1.0)
        gfx_text(190.0, 410.0, 1.6, str_i64(clicks), 1.0, 1.0, 1.0, 1.0)
        gfx_end()
    }
    gfx_shutdown()
}
