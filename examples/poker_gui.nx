fn draw_table_skin(skin: i64) {
    if skin == 1 {
        engine2d_draw_rect(0.0, 0.0, 1920.0, 1080.0, 0.035, 0.12, 0.34, 0.30)
    } else if skin == 2 {
        engine2d_draw_rect(0.0, 0.0, 1920.0, 1080.0, 0.24, 0.055, 0.32, 0.28)
    } else if skin == 3 {
        engine2d_draw_rect(0.0, 0.0, 1920.0, 1080.0, 0.38, 0.035, 0.055, 0.27)
    }
}

