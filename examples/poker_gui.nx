    engine2d_draw_rect(41.0, 33.0, 42.0, 46.0, 0.025, 0.028, 0.030, 1.0)
    text_at(f_h1, 48.0, 32.0, "N", 0.96, 0.78, 0.14, 1.0)
    text_c(f_tiny, 960.0, 46.0, "SINGLE-PLAYER  •  TEXAS HOLD'EM",
           0.72, 0.74, 0.68, 1.0)
    text_c(f_title, 960.0, 178.0, "POKER", 0.98, 0.97, 0.92, 1.0)
    text_c(f_ui, 960.0, 258.0, "NO-LIMIT TEXAS HOLD'EM",
           0.96, 0.78, 0.14, 1.0)

    panel(480.0, 420.0, 960.0, 468.0)
    text_c(f_h1, 960.0, 448.0, "CHOOSE YOUR OPPONENTS", 1.0, 0.93, 0.74, 1.0)
    text_c(f_small, 960.0, 496.0,
           "Pick one to five bots. Your table starts with 1,000 chips each.",
           0.68, 0.76, 0.68, 1.0)

    let mut i = 0
