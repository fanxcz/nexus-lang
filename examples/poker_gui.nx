        paint_button(x, 534.0, 150.0, 92.0, label, f_ui, r, g, b, true)
        i = i + 1
    }

    let mut players_total = bot_count + 1
    text_c(f_small, 960.0, 650.0,
           str_i64(bot_count) + " opponents  •  " +
           str_i64(players_total) + " players  •  blinds 10 / 20",
           0.82, 0.86, 0.80, 1.0)
    text_c(f_ui, 960.0, 680.0, "YOUR STACK  " + money(bankroll),
           1.0, 0.86, 0.40, 1.0)

    paint_button(760.0, 728.0, 400.0, 82.0, "START TABLE", f_h1,
                 0.66, 0.48, 0.10, true)
    paint_button(760.0, 830.0, 400.0, 58.0, "COSMETIC SHOP", f_ui,
                 0.18, 0.24, 0.31, true)

    text_c(f_tiny, 960.0, 920.0,
            "H HELP  •  S SOUND  •  T AUTO-NEXT  •  V FAST BOTS  •  F11 FULLSCREEN",
            0.62, 0.68, 0.62, 1.0)
    text_c(f_tiny, 960.0, 960.0,
            "SESSION  " + str_i64(session_hands) + " HANDS  •  " +
            str_i64(session_wins) + " WINS  •  NET " + money(session_net),
            0.78, 0.82, 0.70, 1.0)
    text_c(f_tiny, 960.0, 1000.0,
            "F FOLD  •  C CHECK/CALL  •  R RAISE  •  A ALL-IN  •  M MENU",
            0.58, 0.64, 0.58, 0.9)
}

