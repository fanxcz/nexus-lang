fn main() {
    let model = gfx3d_model_load("examples/assets/cube.obj")
    if model == 0 {
        print("MODEL ERROR: " + gfx_error())
        return
    }
    let ok = gfx_init(960, 540, "NEXUS OBJ")
    if !ok { print(gfx_error()); return }
    while !gfx_should_close() {
        gfx_poll()
        gfx_clear(0.02,0.025,0.05,1.0)
        gfx3d_begin(70.0,0.1,1000.0,0.0,0.0,6.0,10.0,0.0,0.0)
        gfx3d_grid(10,1.0,0.16,0.22,0.32,1.0)
        gfx3d_model_draw(model,0.0,1.0,0.0,1.2,1.2,1.2,0.0,30.0,0.0)
        gfx3d_end()
    }
    gfx3d_model_unload(model)
    gfx_shutdown()
}
