fn main() {
    // usize/isize are native-sized integer aliases in the current runtime.
    let size: usize = 64
    let address = mem_alloc(size)

    if address == 0 {
        print("allocation failed")
        return
    }

    defer mem_free(address)
    mem_set(address, 65, size)
    print("allocated and initialized 64 bytes")
}
