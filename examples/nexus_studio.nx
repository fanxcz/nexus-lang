fn calculator() {
    clear()
    print("=== CALCULATOR ===")
    let a = input_i64("A: ")
    let b = input_i64("B: ")
    print("sum = " + str_i64(a + b))
    print("difference = " + str_i64(a - b))
    print("product = " + str_i64(a * b))
    if b != 0 { print("division = " + str_i64(a / b)) } else { print("division = undefined") }
    input("Press Enter to continue...")
}

fn guess_game() {
    clear()
    print("=== GUESS GAME ===")
    let secret = random_i64(1, 100)
    let mut attempts = 0
    let mut won = false
    while !won {
        let guess = input_i64("Guess 1..100 (0 quit): ")
        if guess == 0 { return }
        attempts = attempts + 1
        if guess < secret { print("Too low") }
        else if guess > secret { print("Too high") }
        else { print("Correct!"); print("Attempts: " + str_i64(attempts)); won = true }
    }
    input("Press Enter to continue...")
}

fn battle() {
    clear()
    print("=== MINI BATTLE ===")
    let mut hp = 100
    let mut enemy = 100
    let mut turns = 0
    while hp > 0 && enemy > 0 {
        print("Your HP: " + str_i64(hp))
        print("Enemy HP: " + str_i64(enemy))
        print("1 Attack   2 Heal   3 Run")
        let action = input_i64("> ")
        if action == 1 {
            let damage = random_i64(12, 28)
            enemy = enemy - damage
            print("You hit for " + str_i64(damage))
        } else if action == 2 {
            let heal = random_i64(8, 18)
            hp = hp + heal
            if hp > 100 { hp = 100 }
            print("You heal " + str_i64(heal))
        } else if action == 3 {
            print("You escaped")
            return
        } else {
            print("Invalid action")
            continue
        }
        if enemy > 0 {
            let edmg = random_i64(7, 20)
            hp = hp - edmg
            print("Enemy hits for " + str_i64(edmg))
        }
        turns = turns + 1
    }
    if hp > 0 { print("VICTORY after " + str_i64(turns) + " turns") }
    else { print("DEFEAT") }
    input("Press Enter to continue...")
}

fn terminal_game() {
    clear()
    print("Starting terminal game. Use WASD, Q to quit.")
    screen_set_title("NEXUS Terminal Game")
    screen_begin()
    let mut x: i64 = 10
    let mut y: i64 = 8
    let mut score: i64 = 0
    let mut running = true
    while running {
        screen_clear()
        screen_put(0, 0, "NEXUS TERMINAL GAME")
        screen_put(0, 1, "WASD move | Q quit")
        screen_put(x, y, "@")
        screen_put(0, 22, "Score: " + str_i64(score))
        screen_present()
        if key_pressed() {
            let key = read_key()
            if key == 119 { y = y - 1 }
            else if key == 115 { y = y + 1 }
            else if key == 97 { x = x - 1 }
            else if key == 100 { x = x + 1 }
            else if key == 113 { running = false }
            if x < 1 { x = 1 }
            if y < 2 { y = 2 }
            if x > screen_width() - 2 { x = screen_width() - 2 }
            if y > screen_height() - 3 { y = screen_height() - 3 }
            score = score + 1
        }
        sleep(35)
    }
    screen_end()
    print("Game ended. Score: " + str_i64(score))
    input("Press Enter to continue...")
}

fn system_info() {
    clear()
    print("=== NEXUS RUNTIME ===")
    print("Terminal width: " + str_i64(screen_width()))
    print("Terminal height: " + str_i64(screen_height()))
    print("Runtime milliseconds: " + str_i64(time_ms()))
    print("Random test: " + str_i64(random_i64(1, 1000)))
    print("NEXUS can now build interactive CLI apps and terminal games.")
    input("Press Enter to continue...")
}

fn main() {
    let mut running = true
    while running {
        clear()
        print("====================================")
        print("        NEXUS STUDIO / v0.4")
        print("====================================")
        print("1  Calculator")
        print("2  Guess Game")
        print("3  Mini Battle")
        print("4  Terminal Game")
        print("5  Runtime / App Info")
        print("0  Exit")
        let choice = input_i64("Select: ")
        if choice == 1 { calculator() }
        else if choice == 2 { guess_game() }
        else if choice == 3 { battle() }
        else if choice == 4 { terminal_game() }
        else if choice == 5 { system_info() }
        else if choice == 0 { running = false }
        else { print("Unknown choice"); sleep(700) }
    }
    print("Goodbye from NEXUS.")
}
