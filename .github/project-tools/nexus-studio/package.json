{
  "name": "nexus-studio",
  "version": "0.3.0",
  "description": "A focused desktop workspace for NEXUS projects, source editing, compiler builds and integrated commands",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist": "electron-builder",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer.js && node --check renderer/nexus-mode.js && node --check path-guard.cjs && node --test path-guard.test.cjs"
  },
  "dependencies": {
    "ace-builds": "^1.39.1"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.fanxcz.nexusstudio",
    "productName": "NEXUS Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "path-guard.cjs",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "styles.css",
      "renderer/**/*",
      "node_modules/ace-builds/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "NEXUS-Studio-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "NEXUS-Studio-${version}-Linux-${arch}.${ext}",
      "maintainer": "NEXUS Project <noreply@github.com>",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "NEXUS-Studio-${version}-macOS-${arch}.${ext}"
    }
  },
  "author": {
    "name": "fanxcz",
    "url": "https://github.com/fanxcz"
  },
  "homepage": "https://fanxcz.github.io/nexus-lang/studio/",
  "license": "MIT",
  "desktopName": "nexus-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/fanxcz/nexus-lang.git"
  }
}
