fn main() {
    let mut values: [i64; 4] = [1, 2, 3, 4];
    if true {
        let mut middle: mut[]i64 = mut values[1..3];
        middle[0] = 20;
        middle[1] += 30;
        print(len(middle));
        print(middle[0]);
        print(middle[1]);
    }
    // The exclusive borrow ends with its lexical scope.
    values[3] = 40;
    print(values[3]);
}
