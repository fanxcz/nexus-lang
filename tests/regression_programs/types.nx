struct Player {
    id: i64
    health: i64
    speed: f64
}

enum Color {
    Red,
    Green,
    Blue
}

fn pick(which: i64) -> i64 {
    if which == 1 {
        return 10
    }
    return 20
}

fn main() {
    let mut p = Player { id: 1, health: 100, speed: 4.5 }
    p.health = p.health - 25
    print(p.health)
    print(pick(1))
    let color = Color::Green
    match color {
        Color::Red => { print("red") }
        Color::Green => { print("green") }
        _ => { print("other") }
    }
    let mut a = [1, 2, 3]
    a[1] = 99
    print(a[1])
}
