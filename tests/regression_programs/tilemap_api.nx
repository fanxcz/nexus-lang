import std.tilemap
import std.collision2d
import std.math

fn main() {
    let map = tilemap_create(4, 4)
    if map <= 0 {
        print("NEXUS tilemap: FAIL create")
        return
    }

    tilemap_set(map, 4, 4, 1, 2, 1)
    if tilemap_get(map, 4, 4, 1, 2) != 1 {
        print("NEXUS tilemap: FAIL get/set")
        return
    }
    if tilemap_get(map, 4, 4, -1, 2) != 0 {
        print("NEXUS tilemap: FAIL out-of-bounds read")
        return
    }
    if !collision2d_map_overlaps(map, 4, 4, 32.0, 32.0, 64.0, 24.0, 24.0) {
        print("NEXUS tilemap: FAIL overlap")
        return
    }
    if collision2d_map_overlaps(map, 4, 4, 32.0, 0.0, 0.0, 20.0, 20.0) {
        print("NEXUS tilemap: FAIL empty-cell overlap")
        return
    }

    let hit_x = collision2d_move_x(map, 4, 4, 32.0, 0.0, 64.0, 24.0, 24.0, 64.0)
    if hit_x < 7.8 || hit_x > 8.1 {
        print("NEXUS tilemap: FAIL horizontal resolution " + hit_x)
        return
    }

    let hit_y = collision2d_move_y(map, 4, 4, 32.0, 32.0, 0.0, 24.0, 24.0, 64.0)
    if hit_y < 39.8 || hit_y > 40.1 {
        print("NEXUS tilemap: FAIL vertical resolution " + hit_y)
        return
    }

    let outside = collision2d_move_x(map, 4, 4, 32.0, 64.0, 64.0, 24.0, 24.0, 16.0)
    if outside < 79.9 || outside > 80.1 {
        print("NEXUS tilemap: FAIL empty-space movement " + outside)
        return
    }
    if math_floor(-0.2) != -1 || math_floor(1.9) != 1 {
        print("NEXUS tilemap: FAIL floor helper")
        return
    }

    print("NEXUS tilemap: PASS")
}
