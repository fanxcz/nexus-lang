fn max(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    } else {
        return b
    }
}

fn fact(n: i64) -> i64 {
    let mut result: i64 = 1
    let mut i: i64 = 1
    while i <= n {
        result = result * i
        i = i + 1
    }
    return result
}

fn main() {
    print(max(3, 7))
    print(fact(5))
    let mut total: i64 = 0
    for i in 1..6 {
        total += i * 2
    }
    print(total)
    let mut n: i64 = 10
    while n > 0 {
        n = n - 1
        if n == 5 {
            print(n)
        }
    }
}
