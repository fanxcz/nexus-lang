import std.engine2d
import std.sprite2d

fn main() {
    // Compile-only contract test; no window or asset is opened.
    let dt = engine2d_delta_time()
    let texture = sprite2d_load_texture("missing-asset.png")
    if dt < 0.0 { print("unexpected delta") }
    if texture < 0 { print("texture load failed as expected for this compile-only test") }
}
