// UTF-8 helpers: byte vs. character counts and code-point access.
fn main() {
    let text = "Привет"
    print(string.len(text))
    print(string.chars(text))
    print(string.char_at(text, 0))
    print(string.char_at(text, 5))
    print(string.char_at(text, 6))
    print(string.valid_utf8(text))

    let smile = "🙂"
    print(string.len(smile))
    print(string.chars(smile))

    let rebuilt = string.from_char(128578)
    print(string.len(rebuilt))
    print(string.char_at(rebuilt, 0))

    print(string.from_char(65))
}
