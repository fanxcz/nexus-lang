if(NOT DEFINED NEXUS_SOURCE_DIR)
  message(FATAL_ERROR "NEXUS_SOURCE_DIR is required")
endif()

set(EXT_DIR "${NEXUS_SOURCE_DIR}/.github/project-tools/vscode-extension")
file(READ "${EXT_DIR}/package.json" package_json)
file(READ "${EXT_DIR}/syntaxes/nexus.tmLanguage.json" grammar_json)
file(READ "${EXT_DIR}/language-configuration.json" language_json)
file(READ "${EXT_DIR}/snippets/nexus.json" snippets_json)

string(JSON extension_name ERROR_VARIABLE json_error GET "${package_json}" name)
if(json_error OR NOT extension_name STREQUAL "nexus-language")
  message(FATAL_ERROR "Invalid extension package.json: ${json_error}")
endif()
string(JSON language_id ERROR_VARIABLE json_error GET "${package_json}" contributes languages 0 id)
if(json_error OR NOT language_id STREQUAL "nexus")
  message(FATAL_ERROR "Extension must register the nexus language ID: ${json_error}")
endif()
string(JSON file_extension ERROR_VARIABLE json_error GET "${package_json}" contributes languages 0 extensions 0)
if(json_error OR NOT file_extension STREQUAL ".nx")
  message(FATAL_ERROR "Extension must associate .nx files: ${json_error}")
endif()
string(JSON grammar_scope ERROR_VARIABLE json_error GET "${grammar_json}" scopeName)
if(json_error OR NOT grammar_scope STREQUAL "source.nexus")
  message(FATAL_ERROR "Invalid NEXUS TextMate grammar: ${json_error}")
endif()
string(JSON bracket_count ERROR_VARIABLE json_error LENGTH "${language_json}" brackets)
if(json_error OR bracket_count LESS 3)
  message(FATAL_ERROR "NEXUS language configuration has no bracket pairs: ${json_error}")
endif()
string(JSON snippet_count ERROR_VARIABLE json_error LENGTH "${snippets_json}")
if(json_error OR snippet_count LESS 4)
  message(FATAL_ERROR "NEXUS snippet collection is missing or invalid: ${json_error}")
endif()
if(NOT EXISTS "${EXT_DIR}/LICENSE" OR NOT EXISTS "${EXT_DIR}/README.md")
  message(FATAL_ERROR "VS Code extension package is missing its license or README")
endif()
string(JSON extension_main ERROR_VARIABLE json_error GET "${package_json}" main)
if(json_error OR NOT extension_main STREQUAL "./extension.js" OR NOT EXISTS "${EXT_DIR}/extension.js")
  message(FATAL_ERROR "NEXUS extension must have its JavaScript LSP client entry point")
endif()
string(JSON vscode_engine ERROR_VARIABLE json_error GET "${package_json}" engines vscode)
if(json_error OR NOT vscode_engine)
  message(FATAL_ERROR "NEXUS extension must declare a VS Code engine version")
endif()
string(JSON client_dependency ERROR_VARIABLE json_error GET "${package_json}" dependencies vscode-languageclient)
if(json_error OR NOT client_dependency)
  message(FATAL_ERROR "NEXUS extension must declare vscode-languageclient as a runtime dependency")
endif()
file(READ "${EXT_DIR}/extension.js" extension_source)
if(NOT extension_source MATCHES "LanguageClient" OR NOT extension_source MATCHES "args.*lsp")
  message(FATAL_ERROR "NEXUS extension does not launch the language server")
endif()
file(READ "${EXT_DIR}/.vscodeignore" vscodeignore)
if(vscodeignore MATCHES "node_modules")
  message(FATAL_ERROR "VSIX would exclude its runtime dependencies in node_modules")
endif()
message(STATUS "NEXUS VS Code extension metadata smoke test: PASS")
