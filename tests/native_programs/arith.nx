fn main() {
    print(2 + 3 * 4)
    print((2 + 3) * 4)
    print(100 - 58)
    print(17 / 5)
    print(17 % 5)
    print(-17 / 5)
    print(-17 % 5)
    print(-5)
    print(0 - 42)
    print(7 == 7)
    print(7 != 7)
    print(3 < 4)
    print(4 <= 4)
    print(5 > 6)
    print(6 >= 7)
    print(true && false)
    print(true || false)
    print(!true)
    print(!(1 < 2))
    print(1 + 2 == 3 && 4 > 2)
}
