fn touch() -> bool {
    print("rhs")
    return true
}

fn main() {
    print(false && touch())
    print(true || touch())
    print(true && touch())
    print(false || touch())
    let z = 0
    if z != 0 &&(10 / z) > 1 { print("bad") } else { print("guard") }
    let mut i = 0
    while i < 10 && i != 3 { i += 1 }
    print(i)
}
