fn main() {
    let a = 12 & 10
    let b = 12 | 3
    let c = 12 ^ 10
    let d = 1 << 5
    let e = 256 >> 4
    let f = -8 >> 1
    print(a)
    print(b)
    print(c)
    print(d)
    print(e)
    print(f)
    let mut g = 12
    g &= 10
    g |= 1
    g ^= 3
    g <<= 2
    g >>= 1
    print(g)

    // Shift counts use the low six bits on both native and LLVM backends.
    // Counts 64 and 65 therefore behave like 0 and 1, respectively.
    print(1 << 64)
    print(-8 >> 65)
    let mut edge = 3
    edge <<= 64
    edge >>= 65
    print(edge)
}
