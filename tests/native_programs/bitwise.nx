fn main() {
    let a = 12 & 10
    let b = 12 | 3
    let c = 12 ^ 10
    let d = 1 << 5
    let e = 256 >> 4
    let f = -8 >> 1
    print(a)
    print(b)
    print(c)
    print(d)
    print(e)
    print(f)
    let mut g = 12
    g &= 10
    g |= 1
    g ^= 3
    g <<= 2
    g >>= 1
    print(g)
}
